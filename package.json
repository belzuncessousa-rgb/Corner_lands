{
  "name": "corner-lands",
  "private": true,
  "version": "0.1.0",
  "description": "A casual medieval city builder.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:itch": "tsc --noEmit && node scripts/build-itch.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.48.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
