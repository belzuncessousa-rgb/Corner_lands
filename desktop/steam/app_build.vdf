"AppBuild"
{
	"AppID" "APP_ID"
	"Desc" "Corner Lands"
	"ContentRoot" "../out/"
	"BuildOutput" "./output/"
	"Depots"
	{
		"WINDOWS_DEPOT_ID"
		{
			"FileMapping"
			{
				"LocalPath" "win-unpacked/*"
				"DepotPath" "."
				"Recursive" "1"
			}
		}
		"LINUX_DEPOT_ID"
		{
			"FileMapping"
			{
				"LocalPath" "linux-unpacked/*"
				"DepotPath" "."
				"Recursive" "1"
			}
		}
	}
}
